# Ne jamais committer les valeurs réelles de ce fichier.
SONARQUBE_TOKEN=<SONARQUBE_USER_TOKEN>

# SonarQube Server : définir URL.
SONARQUBE_URL=<SONARQUBE_SERVER_URL>

# SonarQube Cloud : définir ORG (et URL seulement si votre région/configuration l'exige).
SONARQUBE_ORG=<SONARQUBE_CLOUD_ORGANIZATION>
